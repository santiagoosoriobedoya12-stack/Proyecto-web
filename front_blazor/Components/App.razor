<!DOCTYPE html>
<!-- Documento HTML raíz de toda la aplicación Blazor Server -->
<html lang="es">
<head>
    <!-- Codificación UTF-8 para tildes, eñes y símbolos monetarios -->
    <meta charset="utf-8" />
    <!-- Hace la aplicación responsiva ajustando el ancho a la pantalla del dispositivo -->
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <!-- Título mostrado en la pestaña del navegador -->
    <title>FactuCorp ERP — Sistema de Facturas v4</title>
    <!-- Ruta base para resolver todos los enlaces y recursos estáticos relativos -->
    <base href="/" />
    <!-- 1. Bootstrap servido LOCALMENTE (sin CDN para funcionar offline/sandbox) -->
    <link rel="stylesheet" href="lib/bootstrap/css/bootstrap.min.css" />
    <!-- 2. Capa de estilos propios e identidad corporativa encima de Bootstrap -->
    <link rel="stylesheet" href="app.css" />
    <!-- Permite que cada página (.razor) cambie dinámicamente el título con <PageTitle> -->
    <HeadOutlet />
</head>
<body>
    <!-- Renderiza el enrutador principal en modo InteractiveServer SIN prerrenderizado (prerender: false),
         necesario para que el estado Scoped de sesión (EstadoSesion) viva solo una vez en el circuito WebSocket real -->
    <Routes @rendermode="@(new InteractiveServerRenderMode(prerender: false))" />
    <!-- Script de Blazor que abre el túnel SignalR/WebSocket en tiempo real con el servidor .NET -->
    <script src="_framework/blazor.web.js"></script>
</body>
</html>
