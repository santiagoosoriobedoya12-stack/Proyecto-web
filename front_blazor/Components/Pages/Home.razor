@page "/"
@inject FrontFacturas.Servicios.EstadoSesion EstadoSesion

<PageTitle>Inicio — FactuCorp ERP v4</PageTitle>

<div class="tarjeta mb-4">
    <div class="tarjeta-header d-flex justify-content-between align-items-center">
        <h2 class="h5 mb-0">Aplicación y Servicios Web — Versión 4 (Analítica, Reportes y Dashboard)</h2>
        <span class="badge bg-primary">Versión 4 Completa</span>
    </div>
    <div class="tarjeta-body">
        <p class="lead">
            Bienvenido al sistema de facturación empresarial desarrollado según la metodología incremental acumulativa ($v1 \subset v2 \subset v3 \subset v4$).
        </p>
        <p>
            En esta <strong>Versión 4</strong>, se completa el ciclo del software con la capa analítica de toma de decisiones:
            <strong>10 Consultas Multitabla Complejas</strong> (cruzando entre 4 y 6 tablas), un <strong>Tablero de Control (Dashboard)</strong> con métricas KPI en tiempo real, 
            identidad corporativa profesional y protección transversal mediante tokens <strong>JWT</strong> y <strong>RBAC</strong>.
        </p>

        @if (!EstadoSesion.EstaAutenticado)
        {
            <div class="alert alert-warning d-flex justify-content-between align-items-center my-3">
                <div>
                    <strong>⚠️ No has iniciado sesión:</strong> Debes identificarte para que la API te otorgue un token JWT y puedas acceder a los módulos autorizados para tu rol.
                </div>
                <a href="sesion" class="btn btn-primary btn-sm px-3">Ir a Iniciar Sesión</a>
            </div>
        }
        else
        {
            <div class="alert alert-success d-flex justify-content-between align-items-center my-3">
                <div>
                    <strong>✔ Sesión activa:</strong> Conectado como <strong>@EstadoSesion.Email</strong> con roles: <em>@string.Join(", ", EstadoSesion.Roles)</em>.
                </div>
                <span class="badge bg-light text-dark border">@EstadoSesion.RutasPermitidas.Count permisos asignados</span>
            </div>
        }

        <div class="row mt-4">
            <div class="col-md-3 mb-3">
                <div class="card h-100 border shadow-sm p-3">
                    <h5 class="fw-bold text-primary">v1: Tablas Planas</h5>
                    <p class="text-muted small">6 tablas base independientes:</p>
                    <div class="d-flex flex-wrap gap-1">
                        <a href="productos" class="btn btn-outline-primary btn-sm">Productos</a>
                        <a href="empresas" class="btn btn-outline-primary btn-sm">Empresas</a>
                        <a href="personas" class="btn btn-outline-primary btn-sm">Personas</a>
                        <a href="roles" class="btn btn-outline-primary btn-sm">Roles</a>
                        <a href="rutas" class="btn btn-outline-primary btn-sm">Rutas</a>
                        <a href="usuarios" class="btn btn-outline-primary btn-sm">Usuarios</a>
                    </div>
                </div>
            </div>
            <div class="col-md-3 mb-3">
                <div class="card h-100 border shadow-sm p-3 border-warning">
                    <h5 class="fw-bold text-dark">v2: FK y SPs</h5>
                    <p class="text-muted small">Tablas dependientes y lógica en BD:</p>
                    <div class="d-flex flex-wrap gap-1">
                        <a href="clientes" class="btn btn-warning btn-sm">Clientes</a>
                        <a href="vendedores" class="btn btn-warning btn-sm">Vendedores</a>
                        <a href="facturas" class="btn btn-warning btn-sm">Facturas</a>
                        <a href="emitir-factura" class="btn btn-warning btn-sm">Emitir Factura</a>
                        <a href="usuarios-y-roles" class="btn btn-warning btn-sm">Usuarios y Roles</a>
                    </div>
                </div>
            </div>
            <div class="col-md-3 mb-3">
                <div class="card h-100 border shadow-sm p-3 border-success">
                    <h5 class="fw-bold text-success">v3: Seguridad RBAC</h5>
                    <p class="text-muted small">JWT, BCrypt y permisos por ruta:</p>
                    <div class="d-flex flex-wrap gap-1">
                        <a href="sesion" class="btn btn-success btn-sm">Iniciar / Ver Sesión</a>
                        <a href="roles-por-usuario" class="btn btn-outline-success btn-sm">Roles Usuario</a>
                        <a href="permisos-por-rol" class="btn btn-outline-success btn-sm">Permisos Rol</a>
                    </div>
                </div>
            </div>
            <div class="col-md-3 mb-3">
                <div class="card h-100 border shadow-sm p-3 border-primary bg-light">
                    <h5 class="fw-bold text-primary">v4: Analítica y Reportes</h5>
                    <p class="text-muted small">10 consultas y tablero de control:</p>
                    <div class="d-flex flex-wrap gap-1">
                        <a href="dashboard" class="btn btn-primary btn-sm">📊 Dashboard</a>
                        <a href="consultas" class="btn btn-outline-primary btn-sm">📈 Consultas</a>
                    </div>
                </div>
            </div>
        </div>
        <hr />
        <div class="d-flex gap-2">
            <a href="http://localhost:8035/swagger" target="_blank" class="btn btn-outline-secondary">
                Documentación Swagger API (/swagger)
            </a>
            <a href="http://localhost:8035/" target="_blank" class="btn btn-outline-info">
                Diagnóstico API (GET /)
            </a>
        </div>
    </div>
</div>

