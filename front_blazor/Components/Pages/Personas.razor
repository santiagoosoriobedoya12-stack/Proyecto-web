@* Ruta URL en Blazor que renderiza esta página: '/personas' *@
@page "/personas"
@* Inyección de dependencia 'ServicioPersona' disponible bajo la variable 'ServicioPersona' *@
@inject ServicioPersona ServicioPersona
@* Activa el modo interactivo en servidor (SignalR/WebSocket) para eventos sin recargar la página *@
@rendermode InteractiveServer

<PageTitle>Personas — Sistema de Facturación v1</PageTitle>

<div class="d-flex justify-content-between align-items-center mb-4">
    <h2>Gestión de Personas</h2>
    <span class="badge bg-secondary">Recurso: /personas</span>
</div>

@* Muestra alerta si la API no responde o si el rol carece de permisos (403 Forbidden) *@
@if (errorConexion)
{
    <div class="alert alert-danger aviso-desconexion mb-4 shadow-sm" role="alert">
        <h4 class="alert-heading">⚠️ Error de conexión con la API</h4>
        <p class="mb-1">No se pudo establecer comunicación con el servicio en <code>/api/persona</code>.</p>
        <button class="btn btn-outline-danger btn-sm mt-3" @onclick="CargarPersonas">Reintentar conexión</button>
    </div>
}

@if (!string.IsNullOrEmpty(mensajeAlerta))
{
    <div class="alert @(esExito ? "alert-success" : "alert-warning") alert-dismissible fade show shadow-sm" role="alert">
        <strong>@(esExito ? "✔ Operación exitosa:" : "⚠️ Atención:")</strong> @mensajeAlerta
        @if (listaErroresValidacion != null && listaErroresValidacion.Count > 0)
        {
            <ul class="mb-0 mt-2">
                @* Recorre cada registro de la colección para renderizar dinámicamente filas o tarjetas *@
                @foreach (var err in listaErroresValidacion)
                {
                    <li>@err</li>
                }
            </ul>
        }
        <button type="button" class="btn-close float-end" @onclick="() => mensajeAlerta = null">X</button>
    </div>
}

<div class="row">
    <div class="col-12 col-lg-5 mb-4">
        <div class="tarjeta">
            <div class="tarjeta-header d-flex justify-content-between align-items-center">
                <span class="fw-bold">@(modoEdicion ? "Editar Persona" : "Nueva Persona")</span>
                @if (modoEdicion)
                {
                    <button class="btn btn-outline-secondary btn-sm" @onclick="CancelarEdicion">Cancelar</button>
                }
            </div>
            <div class="tarjeta-body">
                <div class="mb-3">
                    <label class="form-label">Código / Documento</label>
                    <input type="text" class="form-control" placeholder="Ej: P007"
                           @bind="formularioPersona.Codigo"
                           disabled="@modoEdicion" />
                    <small class="text-muted">Texto único de 1 a 10 caracteres.</small>
                </div>

                <div class="mb-3">
                    <label class="form-label">Nombre completo</label>
                    <input type="text" class="form-control" placeholder="Ej: Andrés Morales"
                           @bind="formularioPersona.Nombre" />
                </div>

                <div class="mb-3">
                    <label class="form-label">Correo electrónico</label>
                    <input type="email" class="form-control" placeholder="Ej: andres@correo.com"
                           @bind="formularioPersona.Email" />
                </div>

                <div class="mb-3">
                    <label class="form-label">Teléfono</label>
                    <input type="text" class="form-control" placeholder="Ej: 3001234567"
                           @bind="formularioPersona.Telefono" />
                </div>

                <div class="acciones mt-4">
                    @if (!modoEdicion)
                    {
                        <button class="btn btn-success" @onclick="CrearPersona" disabled="@cargando">
                            Crear persona
                        </button>
                    }
                    else
                    {
                        <button class="btn btn-primary" @onclick="GuardarFichaCompleta" disabled="@cargando">
                            Guardar la ficha completa
                        </button>
                        <button class="btn btn-secondary" @onclick="GuardarSoloLoCambiado" disabled="@cargando">
                            Guardar solo lo que cambié
                        </button>
                    }
                </div>
            </div>
        </div>
    </div>

    <div class="col-12 col-lg-7 mb-4">
        <div class="tarjeta">
            <div class="tarjeta-header d-flex justify-content-between align-items-center">
                <span class="fw-bold">Listado de Personas</span>
                <span class="badge bg-primary">Total: @listaPersonas.Count</span>
            </div>
            <div class="tarjeta-body p-0">
                @if (cargando)
                {
                    <div class="p-4 text-center text-muted"><em>Cargando personas...</em></div>
                }
                else if (listaPersonas.Count == 0 && !errorConexion)
                {
                    <div class="p-4 text-center text-muted"><em>No hay personas registradas (HTTP 204).</em></div>
                }
                else if (!errorConexion)
                {
                    <div class="table-responsive">
                        <!-- Tabla Bootstrap responsiva para mostrar el listado de registros de la API -->
                        <table class="table table-striped table-hover mb-0 align-middle">
                            <thead class="table-light">
                                <tr>
                                    <th>Código</th>
                                    <th>Nombre</th>
                                    <th>Email</th>
                                    <th>Teléfono</th>
                                    <th class="text-center">Acciones</th>
                                </tr>
                            </thead>
                            <tbody>
                                @* Recorre cada registro de la colección para renderizar dinámicamente filas o tarjetas *@
                                @foreach (var per in listaPersonas)
                                {
                                    <tr>
                                        <td><code>@per.Codigo</code></td>
                                        <td>@per.Nombre</td>
                                        <td>@per.Email</td>
                                        <td>@per.Telefono</td>
                                        <td class="text-center">
                                            <div class="btn-group btn-group-sm">
                                                <button class="btn btn-outline-primary" @onclick="() => CargarEnEdicion(per)">Editar</button>
                                                <button class="btn btn-outline-danger" @onclick="() => EliminarPersona(per.Codigo)">Borrar</button>
                                            </div>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
            </div>
        </div>
    </div>
</div>

@* Lógica C# del componente: estado en memoria, llamadas HTTP y manejo de eventos *@
@code {
    private List<Persona> listaPersonas = new();
    private Persona formularioPersona = new();
    private Persona? personaOriginalEdicion;

    private bool modoEdicion = false;
    private bool cargando = false;
    private bool errorConexion = false;
    private bool esExito = false;
    private string? mensajeAlerta;
    private List<string>? listaErroresValidacion;

    protected override async Task OnInitializedAsync()
    {
        await CargarPersonas();
    }

    // Consulta los datos desde la API manejando errores de red o falta de permisos (401/403)
    private async Task CargarPersonas()
    {
        cargando = true;
        errorConexion = false;
        // Bloque try: ejecuta la operación capturando excepciones de negocio, SQL o red para responder adecuadamente
        try
        {
            listaPersonas = await ServicioPersona.ListarAsync();
        }
        catch
        {
            errorConexion = true;
            listaPersonas = new List<Persona>();
        }
        finally
        {
            cargando = false;
        }
    }

    // Valida los datos de entrada y registra una nueva entidad en el sistema
    private async Task CrearPersona()
    {
        cargando = true;
        mensajeAlerta = null;
        listaErroresValidacion = null;

        var resultado = await ServicioPersona.CrearAsync(formularioPersona);
        if (resultado.Exitoso)
        {
            esExito = true;
            mensajeAlerta = resultado.Mensaje;
            formularioPersona = new Persona();
            await CargarPersonas();
        }
        else
        {
            esExito = false;
            mensajeAlerta = resultado.Mensaje;
            listaErroresValidacion = resultado.ErroresValidacion;
        }

        cargando = false;
    }

    // Carga los datos de la fila seleccionada en el formulario para permitir edición PUT o PATCH
    private void CargarEnEdicion(Persona per)
    {
        modoEdicion = true;
        mensajeAlerta = null;
        listaErroresValidacion = null;

        personaOriginalEdicion = new Persona
        {
            Codigo = per.Codigo,
            Nombre = per.Nombre,
            Email = per.Email,
            Telefono = per.Telefono
        };

        formularioPersona = new Persona
        {
            Codigo = per.Codigo,
            Nombre = per.Nombre,
            Email = per.Email,
            Telefono = per.Telefono
        };
    }

    // Limpia el formulario actual y regresa al modo de creación
    private void CancelarEdicion()
    {
        modoEdicion = false;
        formularioPersona = new Persona();
        personaOriginalEdicion = null;
        mensajeAlerta = null;
        listaErroresValidacion = null;
    }

    // Envía petición PUT a la API para reemplazar toda la ficha del registro
    private async Task GuardarFichaCompleta()
    {
        cargando = true;
        mensajeAlerta = null;
        listaErroresValidacion = null;

        var resultado = await ServicioPersona.GuardarFichaCompletaAsync(formularioPersona);
        if (resultado.Exitoso)
        {
            esExito = true;
            mensajeAlerta = resultado.Mensaje;
            CancelarEdicion();
            await CargarPersonas();
        }
        else
        {
            esExito = false;
            mensajeAlerta = resultado.Mensaje;
            listaErroresValidacion = resultado.ErroresValidacion;
        }

        cargando = false;
    }

    // Envía petición PATCH a la API únicamente con los campos editados
    private async Task GuardarSoloLoCambiado()
    {
        cargando = true;
        mensajeAlerta = null;
        listaErroresValidacion = null;

        var cambios = new Dictionary<string, object>();
        if (personaOriginalEdicion != null)
        {
            if (formularioPersona.Nombre != personaOriginalEdicion.Nombre)
                cambios["nombre"] = formularioPersona.Nombre;
            if (formularioPersona.Email != personaOriginalEdicion.Email)
                cambios["email"] = formularioPersona.Email;
            if (formularioPersona.Telefono != personaOriginalEdicion.Telefono)
                cambios["telefono"] = formularioPersona.Telefono;
        }

        if (cambios.Count == 0)
        {
            esExito = false;
            mensajeAlerta = "No se detectaron cambios para guardar.";
            cargando = false;
            return;
        }

        var resultado = await ServicioPersona.GuardarSoloLoCambiadoAsync(formularioPersona.Codigo, cambios);
        if (resultado.Exitoso)
        {
            esExito = true;
            mensajeAlerta = resultado.Mensaje;
            CancelarEdicion();
            await CargarPersonas();
        }
        else
        {
            esExito = false;
            mensajeAlerta = resultado.Mensaje;
            listaErroresValidacion = resultado.ErroresValidacion;
        }

        cargando = false;
    }

    // Elimina el registro especificado validando su existencia previa
    private async Task EliminarPersona(string codigo)
    {
        cargando = true;
        mensajeAlerta = null;

        var resultado = await ServicioPersona.EliminarAsync(codigo);
        if (resultado.Exitoso)
        {
            esExito = true;
            mensajeAlerta = resultado.Mensaje;
            if (modoEdicion && formularioPersona.Codigo == codigo)
            {
                CancelarEdicion();
            }
            await CargarPersonas();
        }
        else
        {
            esExito = false;
            mensajeAlerta = resultado.Mensaje;
        }

        cargando = false;
    }
}

