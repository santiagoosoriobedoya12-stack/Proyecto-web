@page "/rutas"
@inject ServicioRuta ServicioRuta
@rendermode InteractiveServer

<PageTitle>Rutas — Sistema de Facturación v1</PageTitle>

<div class="d-flex justify-content-between align-items-center mb-4">
    <h2>Gestión de Rutas</h2>
    <span class="badge bg-secondary">Recurso: /rutas</span>
</div>

@if (errorConexion)
{
    <div class="alert alert-danger aviso-desconexion mb-4 shadow-sm" role="alert">
        <h4 class="alert-heading">⚠️ Error de conexión con la API</h4>
        <p class="mb-1">No se pudo establecer comunicación con el servicio en <code>/api/ruta</code>.</p>
        <button class="btn btn-outline-danger btn-sm mt-3" @onclick="CargarRutas">Reintentar conexión</button>
    </div>
}

@if (!string.IsNullOrEmpty(mensajeAlerta))
{
    <div class="alert @(esExito ? "alert-success" : "alert-warning") alert-dismissible fade show shadow-sm" role="alert">
        <strong>@(esExito ? "✔ Operación exitosa:" : "⚠️ Atención:")</strong> @mensajeAlerta
        @if (listaErroresValidacion != null && listaErroresValidacion.Count > 0)
        {
            <ul class="mb-0 mt-2">
                @foreach (var err in listaErroresValidacion)
                {
                    <li>@err</li>
                }
            </ul>
        }
        <button type="button" class="btn-close float-end" @onclick="() => mensajeAlerta = null">X</button>
    </div>
}

<div class="row">
    <div class="col-12 col-lg-5 mb-4">
        <div class="tarjeta">
            <div class="tarjeta-header d-flex justify-content-between align-items-center">
                <span class="fw-bold">@(modoEdicion ? "Editar Ruta" : "Nueva Ruta")</span>
                @if (modoEdicion)
                {
                    <button class="btn btn-outline-secondary btn-sm" @onclick="CancelarEdicion">Cancelar</button>
                }
            </div>
            <div class="tarjeta-body">
                @if (modoEdicion)
                {
                    <div class="mb-3">
                        <label class="form-label">ID de la Ruta</label>
                        <input type="text" class="form-control" value="@formularioRuta.Id" disabled />
                        <small class="text-muted">Generado con IDENTITY.</small>
                    </div>
                }

                <div class="mb-3">
                    <label class="form-label">Identificador de Ruta (con punto)</label>
                    <input type="text" class="form-control" placeholder="Ej: interfaz.reportes"
                           @bind="formularioRuta.NombreRuta" />
                    <small class="text-muted">Notación con punto (ej. <code>interfaz.modulo</code> o <code>permiso.accion</code>).</small>
                </div>

                <div class="mb-3">
                    <label class="form-label">Descripción</label>
                    <input type="text" class="form-control" placeholder="Ej: Acceso a reportes gerenciales"
                           @bind="formularioRuta.Descripcion" />
                </div>

                <div class="acciones mt-4">
                    @if (!modoEdicion)
                    {
                        <button class="btn btn-success" @onclick="CrearRuta" disabled="@cargando">
                            Crear ruta
                        </button>
                    }
                    else
                    {
                        <button class="btn btn-primary" @onclick="GuardarFichaCompleta" disabled="@cargando">
                            Guardar la ficha completa
                        </button>
                        <button class="btn btn-secondary" @onclick="GuardarSoloLoCambiado" disabled="@cargando">
                            Guardar solo lo que cambié
                        </button>
                    }
                </div>
            </div>
        </div>
    </div>

    <div class="col-12 col-lg-7 mb-4">
        <div class="tarjeta">
            <div class="tarjeta-header d-flex justify-content-between align-items-center">
                <span class="fw-bold">Listado de Rutas Protegibles</span>
                <span class="badge bg-primary">Total: @listaRutas.Count</span>
            </div>
            <div class="tarjeta-body p-0">
                @if (cargando)
                {
                    <div class="p-4 text-center text-muted"><em>Cargando rutas...</em></div>
                }
                else if (listaRutas.Count == 0 && !errorConexion)
                {
                    <div class="p-4 text-center text-muted"><em>No hay rutas registradas (HTTP 204).</em></div>
                }
                else if (!errorConexion)
                {
                    <div class="table-responsive">
                        <table class="table table-striped table-hover mb-0 align-middle">
                            <thead class="table-light">
                                <tr>
                                    <th>ID</th>
                                    <th>Ruta Protegible</th>
                                    <th>Descripción</th>
                                    <th class="text-center">Acciones</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var r in listaRutas)
                                {
                                    <tr>
                                        <td><span class="badge bg-secondary">#@r.Id</span></td>
                                        <td><code>@r.NombreRuta</code></td>
                                        <td>@r.Descripcion</td>
                                        <td class="text-center">
                                            <div class="btn-group btn-group-sm">
                                                <button class="btn btn-outline-primary" @onclick="() => CargarEnEdicion(r)">Editar</button>
                                                <button class="btn btn-outline-danger" @onclick="() => EliminarRuta(r.Id)">Borrar</button>
                                            </div>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
            </div>
        </div>
    </div>
</div>

@code {
    private List<Ruta> listaRutas = new();
    private Ruta formularioRuta = new();
    private Ruta? rutaOriginalEdicion;

    private bool modoEdicion = false;
    private bool cargando = false;
    private bool errorConexion = false;
    private bool esExito = false;
    private string? mensajeAlerta;
    private List<string>? listaErroresValidacion;

    protected override async Task OnInitializedAsync()
    {
        await CargarRutas();
    }

    private async Task CargarRutas()
    {
        cargando = true;
        errorConexion = false;
        try
        {
            listaRutas = await ServicioRuta.ListarAsync();
        }
        catch
        {
            errorConexion = true;
            listaRutas = new List<Ruta>();
        }
        finally
        {
            cargando = false;
        }
    }

    private async Task CrearRuta()
    {
        cargando = true;
        mensajeAlerta = null;
        listaErroresValidacion = null;

        var resultado = await ServicioRuta.CrearAsync(formularioRuta);
        if (resultado.Exitoso)
        {
            esExito = true;
            mensajeAlerta = resultado.Mensaje;
            formularioRuta = new Ruta();
            await CargarRutas();
        }
        else
        {
            esExito = false;
            mensajeAlerta = resultado.Mensaje;
            listaErroresValidacion = resultado.ErroresValidacion;
        }

        cargando = false;
    }

    private void CargarEnEdicion(Ruta r)
    {
        modoEdicion = true;
        mensajeAlerta = null;
        listaErroresValidacion = null;

        rutaOriginalEdicion = new Ruta { Id = r.Id, NombreRuta = r.NombreRuta, Descripcion = r.Descripcion };
        formularioRuta = new Ruta { Id = r.Id, NombreRuta = r.NombreRuta, Descripcion = r.Descripcion };
    }

    private void CancelarEdicion()
    {
        modoEdicion = false;
        formularioRuta = new Ruta();
        rutaOriginalEdicion = null;
        mensajeAlerta = null;
        listaErroresValidacion = null;
    }

    private async Task GuardarFichaCompleta()
    {
        cargando = true;
        mensajeAlerta = null;
        listaErroresValidacion = null;

        var resultado = await ServicioRuta.GuardarFichaCompletaAsync(formularioRuta);
        if (resultado.Exitoso)
        {
            esExito = true;
            mensajeAlerta = resultado.Mensaje;
            CancelarEdicion();
            await CargarRutas();
        }
        else
        {
            esExito = false;
            mensajeAlerta = resultado.Mensaje;
            listaErroresValidacion = resultado.ErroresValidacion;
        }

        cargando = false;
    }

    private async Task GuardarSoloLoCambiado()
    {
        cargando = true;
        mensajeAlerta = null;
        listaErroresValidacion = null;

        var cambios = new Dictionary<string, object>();
        if (rutaOriginalEdicion != null)
        {
            if (formularioRuta.NombreRuta != rutaOriginalEdicion.NombreRuta)
                cambios["ruta"] = formularioRuta.NombreRuta;
            if (formularioRuta.Descripcion != rutaOriginalEdicion.Descripcion)
                cambios["descripcion"] = formularioRuta.Descripcion;
        }

        if (cambios.Count == 0)
        {
            esExito = false;
            mensajeAlerta = "No se detectaron cambios para guardar.";
            cargando = false;
            return;
        }

        var resultado = await ServicioRuta.GuardarSoloLoCambiadoAsync(formularioRuta.Id, cambios);
        if (resultado.Exitoso)
        {
            esExito = true;
            mensajeAlerta = resultado.Mensaje;
            CancelarEdicion();
            await CargarRutas();
        }
        else
        {
            esExito = false;
            mensajeAlerta = resultado.Mensaje;
            listaErroresValidacion = resultado.ErroresValidacion;
        }

        cargando = false;
    }

    private async Task EliminarRuta(int id)
    {
        cargando = true;
        mensajeAlerta = null;

        var resultado = await ServicioRuta.EliminarAsync(id);
        if (resultado.Exitoso)
        {
            esExito = true;
            mensajeAlerta = resultado.Mensaje;
            if (modoEdicion && formularioRuta.Id == id)
            {
                CancelarEdicion();
            }
            await CargarRutas();
        }
        else
        {
            esExito = false;
            mensajeAlerta = resultado.Mensaje;
        }

        cargando = false;
    }
}

