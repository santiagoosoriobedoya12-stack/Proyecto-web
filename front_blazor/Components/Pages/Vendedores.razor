@* Ruta URL en Blazor que renderiza esta página: '/vendedores' *@
@page "/vendedores"
@* Inyección de dependencia 'ServicioVendedor' disponible bajo la variable 'ServicioVendedor' *@
@inject ServicioVendedor ServicioVendedor
@* Inyección de dependencia 'ServicioPersona' disponible bajo la variable 'ServicioPersona' *@
@inject ServicioPersona ServicioPersona
@* Activa el modo interactivo en servidor (SignalR/WebSocket) para eventos sin recargar la página *@
@rendermode InteractiveServer

<PageTitle>Vendedores — Sistema de Facturación v2</PageTitle>

<div class="d-flex justify-content-between align-items-center mb-4">
    <h2>Gestión de Vendedores</h2>
    <span class="badge bg-primary">Versión 2 · Clave Foránea Obligatoria</span>
</div>

@* Muestra alerta si la API no responde o si el rol carece de permisos (403 Forbidden) *@
@if (errorConexion)
{
    <div class="alert alert-danger aviso-desconexion mb-4 shadow-sm" role="alert">
        <h4 class="alert-heading">⚠️ Error de conexión con la API</h4>
        <p class="mb-1">No se pudo establecer comunicación con el servicio en <code>/api/vendedor</code>.</p>
        <button class="btn btn-outline-danger btn-sm mt-3" @onclick="CargarDatos">Reintentar conexión</button>
    </div>
}

@if (!string.IsNullOrEmpty(mensajeAlerta))
{
    <div class="alert @(esExito ? "alert-success" : "alert-warning") alert-dismissible fade show shadow-sm" role="alert">
        <strong>@(esExito ? "✔ Operación exitosa:" : "⚠️ Atención:")</strong> @mensajeAlerta
        @if (listaErroresValidacion != null && listaErroresValidacion.Count > 0)
        {
            <ul class="mb-0 mt-2">
                @* Recorre cada registro de la colección para renderizar dinámicamente filas o tarjetas *@
                @foreach (var err in listaErroresValidacion)
                {
                    <li>@err</li>
                }
            </ul>
        }
        <button type="button" class="btn-close float-end" @onclick="() => mensajeAlerta = null">X</button>
    </div>
}

<div class="row">
    <!-- Formulario de Creación / Edición -->
    <div class="col-12 col-lg-5 mb-4">
        <div class="tarjeta">
            <div class="tarjeta-header d-flex justify-content-between align-items-center">
                <span class="fw-bold">@(modoEdicion ? "Editar Vendedor" : "Nuevo Vendedor")</span>
                @if (modoEdicion)
                {
                    <button class="btn btn-outline-secondary btn-sm" @onclick="CancelarEdicion">Cancelar</button>
                }
            </div>
            <div class="tarjeta-body">
                @if (modoEdicion)
                {
                    <div class="mb-3">
                        <label class="form-label">ID del Vendedor</label>
                        <input type="text" class="form-control" value="@formularioVendedor.Id" disabled />
                        <small class="text-muted">Generado automáticamente por IDENTITY(1,1).</small>
                    </div>
                }

                <div class="mb-3">
                    <label class="form-label">Número de Carnet</label>
                    <input type="number" class="form-control" placeholder="Ej: 1045"
                           @bind="formularioVendedor.Carnet" />
                </div>

                <div class="mb-3">
                    <label class="form-label">Dirección de Contacto</label>
                    <input type="text" class="form-control" placeholder="Ej: Calle 50 # 40-20"
                           @bind="formularioVendedor.Direccion" />
                </div>

                <!-- Criterio 11 y 12: Select de Persona cargado dinámicamente de la API -->
                <div class="mb-3">
                    <label class="form-label">Persona Asociada (FK Obligatoria)</label>
                    <!-- Selector dinámico alimentado por la API para elegir claves foráneas por nombre (Versión 2) -->
                    <select class="form-select" @bind="formularioVendedor.Fkcodpersona">
                        <option value="">-- Seleccione una Persona --</option>
                        @* Recorre cada registro de la colección para renderizar dinámicamente filas o tarjetas *@
                        @foreach (var p in listaPersonas)
                        {
                            <option value="@p.Codigo">@p.Nombre (@p.Codigo)</option>
                        }
                    </select>
                    <small class="text-muted">El vendedor debe existir previamente en la tabla <code>persona</code>.</small>
                </div>

                <div class="mt-4">
                    @if (!modoEdicion)
                    {
                        <button class="btn btn-primary w-100" @onclick="CrearVendedor">
                            Crear Vendedor (POST)
                        </button>
                    }
                    else
                    {
                        <div class="d-grid gap-2">
                            <button class="btn btn-success" @onclick="GuardarFichaCompleta">
                                Guardar la ficha completa (PUT)
                            </button>
                            <button class="btn btn-outline-primary" @onclick="GuardarSoloLoCambiado">
                                Guardar solo lo que cambié (PATCH)
                            </button>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>

    <!-- Tabla de Listado -->
    <div class="col-12 col-lg-7">
        <div class="tarjeta">
            <div class="tarjeta-header d-flex justify-content-between align-items-center">
                <span class="fw-bold">Listado de Vendedores</span>
                <button class="btn btn-sm btn-outline-primary" @onclick="CargarDatos">Actualizar</button>
            </div>
            <div class="tarjeta-body p-0">
                <div class="table-responsive">
                    <!-- Tabla Bootstrap responsiva para mostrar el listado de registros de la API -->
                    <table class="table table-hover mb-0">
                        <thead class="table-light">
                            <tr>
                                <th>ID</th>
                                <th>Carnet</th>
                                <th>Persona</th>
                                <th>Dirección</th>
                                <th class="text-end">Acciones</th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (listaVendedores.Count == 0)
                            {
                                <tr>
                                    <td colspan="5" class="text-center text-muted py-4">
                                        No se encontraron vendedores registrados.
                                    </td>
                                </tr>
                            }
                            else
                            {
                                @* Recorre cada registro de la colección para renderizar dinámicamente filas o tarjetas *@
                                @foreach (var v in listaVendedores)
                                {
                                    <tr>
                                        <td><strong>#@v.Id</strong></td>
                                        <td>@v.Carnet</td>
                                        <td>@ObtenerNombrePersona(v.Fkcodpersona)</td>
                                        <td>@v.Direccion</td>
                                        <td class="text-end">
                                            <button class="btn btn-outline-primary btn-sm me-1" @onclick="() => IniciarEdicion(v)">
                                                Editar
                                            </button>
                                            <button class="btn btn-outline-danger btn-sm" @onclick="() => EliminarVendedor(v.Id)">
                                                Eliminar
                                            </button>
                                        </td>
                                    </tr>
                                }
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</div>

@* Lógica C# del componente: estado en memoria, llamadas HTTP y manejo de eventos *@
@code {
    private List<Vendedor> listaVendedores = new();
    private List<Persona> listaPersonas = new();

    private Vendedor formularioVendedor = new();
    private Vendedor vendedorOriginal = new();

    private bool modoEdicion = false;
    private bool errorConexion = false;
    private string? mensajeAlerta;
    private bool esExito = false;
    private List<string>? listaErroresValidacion;

    protected override async Task OnInitializedAsync()
    {
        await CargarDatos();
    }

    // Consulta los datos desde la API manejando errores de red o falta de permisos (401/403)
    private async Task CargarDatos()
    {
        errorConexion = false;
        mensajeAlerta = null;
        // Bloque try: ejecuta la operación capturando excepciones de negocio, SQL o red para responder adecuadamente
        try
        {
            var tareaVendedores = ServicioVendedor.ListarAsync();
            var tareaPersonas = ServicioPersona.ListarAsync();

            await Task.WhenAll(tareaVendedores, tareaPersonas);

            listaVendedores = await tareaVendedores;
            listaPersonas = await tareaPersonas;
        }
        catch
        {
            errorConexion = true;
        }
    }

    // Ejecuta la operación 'ObtenerNombrePersona' dentro de la capa correspondiente
    private string ObtenerNombrePersona(string codigo)
    {
        var p = listaPersonas.FirstOrDefault(x => x.Codigo == codigo);
        return p != null ? $"{p.Nombre} ({codigo})" : codigo;
    }

    // Valida los datos de entrada y registra una nueva entidad en el sistema
    private async Task CrearVendedor()
    {
        mensajeAlerta = null;
        listaErroresValidacion = null;

        if (formularioVendedor.Carnet <= 0)
        {
            mensajeAlerta = "El carnet debe ser mayor a cero.";
            esExito = false;
            return;
        }

        // Valida que el identificador o cadena requerida no llegue nula ni vacía
        if (string.IsNullOrWhiteSpace(formularioVendedor.Fkcodpersona))
        {
            mensajeAlerta = "Debe seleccionar una persona obligatoriamente.";
            esExito = false;
            return;
        }

        var resultado = await ServicioVendedor.CrearAsync(formularioVendedor);
        esExito = resultado.Exitoso;
        mensajeAlerta = resultado.Mensaje;
        listaErroresValidacion = resultado.ErroresValidacion;

        if (resultado.Exitoso)
        {
            formularioVendedor = new Vendedor();
            await CargarDatos();
        }
    }

    // Ejecuta la operación 'IniciarEdicion' dentro de la capa correspondiente
    private void IniciarEdicion(Vendedor v)
    {
        modoEdicion = true;
        mensajeAlerta = null;
        listaErroresValidacion = null;

        vendedorOriginal = new Vendedor
        {
            Id = v.Id,
            Carnet = v.Carnet,
            Direccion = v.Direccion,
            Fkcodpersona = v.Fkcodpersona
        };

        formularioVendedor = new Vendedor
        {
            Id = v.Id,
            Carnet = v.Carnet,
            Direccion = v.Direccion,
            Fkcodpersona = v.Fkcodpersona
        };
    }

    // Limpia el formulario actual y regresa al modo de creación
    private void CancelarEdicion()
    {
        modoEdicion = false;
        formularioVendedor = new Vendedor();
        mensajeAlerta = null;
        listaErroresValidacion = null;
    }

    // Envía petición PUT a la API para reemplazar toda la ficha del registro
    private async Task GuardarFichaCompleta()
    {
        mensajeAlerta = null;
        listaErroresValidacion = null;

        var resultado = await ServicioVendedor.GuardarFichaCompletaAsync(formularioVendedor);
        esExito = resultado.Exitoso;
        mensajeAlerta = resultado.Mensaje;
        listaErroresValidacion = resultado.ErroresValidacion;

        if (resultado.Exitoso)
        {
            CancelarEdicion();
            await CargarDatos();
        }
    }

    // Envía petición PATCH a la API únicamente con los campos editados
    private async Task GuardarSoloLoCambiado()
    {
        mensajeAlerta = null;
        listaErroresValidacion = null;

        var cambios = new Dictionary<string, object>();

        if (formularioVendedor.Carnet != vendedorOriginal.Carnet)
        {
            cambios["carnet"] = formularioVendedor.Carnet;
        }

        if (formularioVendedor.Direccion != vendedorOriginal.Direccion)
        {
            cambios["direccion"] = formularioVendedor.Direccion;
        }

        if (formularioVendedor.Fkcodpersona != vendedorOriginal.Fkcodpersona)
        {
            cambios["fkcodpersona"] = formularioVendedor.Fkcodpersona;
        }

        if (cambios.Count == 0)
        {
            mensajeAlerta = "No se detectó ningún cambio en el formulario.";
            esExito = false;
            return;
        }

        var resultado = await ServicioVendedor.GuardarSoloLoCambiadoAsync(formularioVendedor.Id, cambios);
        esExito = resultado.Exitoso;
        mensajeAlerta = resultado.Mensaje;
        listaErroresValidacion = resultado.ErroresValidacion;

        if (resultado.Exitoso)
        {
            CancelarEdicion();
            await CargarDatos();
        }
    }

    // Elimina el registro especificado validando su existencia previa
    private async Task EliminarVendedor(int id)
    {
        if (modoEdicion && formularioVendedor.Id == id)
        {
            CancelarEdicion();
        }

        var resultado = await ServicioVendedor.EliminarAsync(id);
        esExito = resultado.Exitoso;
        mensajeAlerta = resultado.Mensaje;
        listaErroresValidacion = resultado.ErroresValidacion;

        if (resultado.Exitoso)
        {
            await CargarDatos();
        }
    }
}

