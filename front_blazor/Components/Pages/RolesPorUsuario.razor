@page "/roles-por-usuario"
@inject ServicioRolUsuario ServicioRolUsuario
@inject ServicioUsuario ServicioUsuario
@inject ServicioRol ServicioRol
@rendermode InteractiveServer

<PageTitle>Roles por Usuario — Sistema de Facturación v2</PageTitle>

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h2>Roles por Usuario (Tabla Puente rol_usuario)</h2>
        <span class="badge bg-secondary">Sin editar · Borrado con dos claves (3_plan.md 3.5)</span>
    </div>
</div>

@if (errorConexion)
{
    <div class="alert alert-danger aviso-desconexion mb-4 shadow-sm" role="alert">
        <h4 class="alert-heading">⚠️ Error de conexión con la API</h4>
        <p class="mb-1">No se pudo establecer comunicación con el servicio en <code>/api/rol-usuario</code>.</p>
        <button class="btn btn-outline-danger btn-sm mt-3" @onclick="CargarDatos">Reintentar conexión</button>
    </div>
}

@if (!string.IsNullOrEmpty(mensajeAlerta))
{
    <div class="alert @(esExito ? "alert-success" : "alert-warning") alert-dismissible fade show shadow-sm" role="alert">
        <strong>@(esExito ? "✔ Operación exitosa:" : "⚠️ Atención:")</strong> @mensajeAlerta
        <button type="button" class="btn-close float-end" @onclick="() => mensajeAlerta = null">X</button>
    </div>
}

<div class="row">
    <!-- Formulario para Asignar Pareja (Sin PUT ni PATCH) -->
    <div class="col-12 col-lg-5 mb-4">
        <div class="tarjeta">
            <div class="tarjeta-header">
                <span class="fw-bold">Asignar Rol a Usuario</span>
            </div>
            <div class="tarjeta-body">
                <div class="mb-3">
                    <label class="form-label">Usuario (Email)</label>
                    <select class="form-select" @bind="emailSeleccionado">
                        <option value="">-- Seleccione un Usuario --</option>
                        @foreach (var u in listaUsuarios)
                        {
                            <option value="@u.Email">@u.Email</option>
                        }
                    </select>
                </div>

                <div class="mb-3">
                    <label class="form-label">Rol a Asignar</label>
                    <select class="form-select" @bind="rolSeleccionadoId">
                        <option value="0">-- Seleccione un Rol --</option>
                        @foreach (var r in listaRoles)
                        {
                            <option value="@r.Id">@r.Nombre (ID: @r.Id)</option>
                        }
                    </select>
                </div>

                <div class="alert alert-light border small text-muted mb-3">
                    ℹ️ <strong>Regla RF4:</strong> Una tabla puente no tiene columnas propias ni edición. La pareja existe o no existe. Si intenta agregar una ya existente, la API responderá <strong>409 Conflict</strong>.
                </div>

                <button class="btn btn-primary w-100" @onclick="AsignarRol"
                        disabled="@(string.IsNullOrWhiteSpace(emailSeleccionado) || rolSeleccionadoId == 0)">
                    Asignar Rol (POST)
                </button>
            </div>
        </div>
    </div>

    <!-- Tabla de Asignaciones Actuales -->
    <div class="col-12 col-lg-7">
        <div class="tarjeta">
            <div class="tarjeta-header d-flex justify-content-between align-items-center">
                <span class="fw-bold">Parejas Registradas (@listaAsignaciones.Count)</span>
                <button class="btn btn-sm btn-outline-primary" @onclick="CargarDatos">Actualizar</button>
            </div>
            <div class="tarjeta-body p-0">
                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0">
                        <thead class="table-light">
                            <tr>
                                <th>Usuario</th>
                                <th>Rol</th>
                                <th class="text-end">Acción</th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (listaAsignaciones.Count == 0)
                            {
                                <tr>
                                    <td colspan="3" class="text-center text-muted py-4">
                                        No hay parejas asignadas en la tabla puente rol_usuario.
                                    </td>
                                </tr>
                            }
                            else
                            {
                                @foreach (var a in listaAsignaciones)
                                {
                                    <tr>
                                        <td><strong>@a.Fkemail</strong></td>
                                        <td><span class="badge bg-primary">@(a.NombreRol ?? $"Rol #{a.Fkidrol}")</span></td>
                                        <td class="text-end">
                                            <!-- Quitar exige ambas claves (email y idrol) -->
                                            <button class="btn btn-outline-danger btn-sm" @onclick="() => QuitarAsignacion(a.Fkemail, a.Fkidrol)">
                                                Quitar Pareja
                                            </button>
                                        </td>
                                    </tr>
                                }
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</div>

@code {
    private List<RolUsuario> listaAsignaciones = new();
    private List<Usuario> listaUsuarios = new();
    private List<Rol> listaRoles = new();

    private string emailSeleccionado = string.Empty;
    private int rolSeleccionadoId = 0;

    private bool errorConexion = false;
    private string? mensajeAlerta;
    private bool esExito = false;

    protected override async Task OnInitializedAsync()
    {
        await CargarDatos();
    }

    private async Task CargarDatos()
    {
        errorConexion = false;
        mensajeAlerta = null;
        try
        {
            var tareaAsignaciones = ServicioRolUsuario.ListarAsync();
            var tareaUsuarios = ServicioUsuario.ListarAsync();
            var tareaRoles = ServicioRol.ListarAsync();

            await Task.WhenAll(tareaAsignaciones, tareaUsuarios, tareaRoles);

            listaAsignaciones = await tareaAsignaciones;
            listaUsuarios = await tareaUsuarios;
            listaRoles = await tareaRoles;
        }
        catch
        {
            errorConexion = true;
        }
    }

    private async Task AsignarRol()
    {
        mensajeAlerta = null;

        var resultado = await ServicioRolUsuario.AsignarAsync(emailSeleccionado, rolSeleccionadoId);
        esExito = resultado.Exitoso;
        mensajeAlerta = resultado.Mensaje;

        if (resultado.Exitoso)
        {
            emailSeleccionado = string.Empty;
            rolSeleccionadoId = 0;
            await CargarDatos();
        }
    }

    private async Task QuitarAsignacion(string email, int idRol)
    {
        mensajeAlerta = null;

        var resultado = await ServicioRolUsuario.QuitarAsync(email, idRol);
        esExito = resultado.Exitoso;
        mensajeAlerta = resultado.Mensaje;

        if (resultado.Exitoso)
        {
            await CargarDatos();
        }
    }
}

