    /// <summary>
    /// Calcula el conteo de registros resultantes aplicando el filtro de texto activo.
    /// </summary>
    private int ObtenerCantidadRegistros() => consultaSeleccionada switch
    {
        "c1" => FiltrarC1().Count(),
        "c2" => FiltrarC2().Count(),
        "c3" => FiltrarC3().Count(),
        "c4" => FiltrarC4().Count(),
        "c5" => FiltrarC5().Count(),
        "c6" => FiltrarC6().Count(),
        "c7" => FiltrarC7().Count(),
        "c8" => FiltrarC8().Count(),
        "c9" => FiltrarC9().Count(),
        "c10" => FiltrarC10().Count(),
        _ => 0
    };

    // Funciones LINQ de filtrado reactivo en el cliente:
    private IEnumerable<ConsultaFacturaDetalladaDto> FiltrarC1() =>
        string.IsNullOrWhiteSpace(filtroTexto) ? listaC1 :
        listaC1.Where(x => x.ClienteNombre.Contains(filtroTexto, StringComparison.OrdinalIgnoreCase) ||
                           x.VendedorNombre.Contains(filtroTexto, StringComparison.OrdinalIgnoreCase) ||
                           x.NumeroFactura.ToString().Contains(filtroTexto));

    private IEnumerable<ConsultaRankingProductosDto> FiltrarC2() =>
        string.IsNullOrWhiteSpace(filtroTexto) ? listaC2 :
