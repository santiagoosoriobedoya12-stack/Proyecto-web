@* Ruta URL en Blazor que renderiza esta página: '/permisos-por-rol' *@
@page "/permisos-por-rol"
@* Ruta URL en Blazor que renderiza esta página: '/permisos' *@
@page "/permisos"
@* Inyección de dependencia 'ServicioRutaRol' disponible bajo la variable 'ServicioRutaRol' *@
@inject ServicioRutaRol ServicioRutaRol
@* Inyección de dependencia 'ServicioRuta' disponible bajo la variable 'ServicioRuta' *@
@inject ServicioRuta ServicioRuta
@* Inyección de dependencia 'ServicioRol' disponible bajo la variable 'ServicioRol' *@
@inject ServicioRol ServicioRol
@* Activa el modo interactivo en servidor (SignalR/WebSocket) para eventos sin recargar la página *@
@rendermode InteractiveServer

<PageTitle>Permisos por Rol — Sistema de Facturación v2</PageTitle>

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h2>Permisos por Rol (Tabla Puente rutarol)</h2>
        <span class="badge bg-secondary">Sin editar · Borrado con dos claves (3_plan.md 3.5)</span>
    </div>
</div>

<div class="alert alert-warning mb-4 shadow-sm" role="alert">
    <h5 class="alert-heading">ℹ️ Aviso de Alcance Metodológico (3_plan.md 3.5)</h5>
    <p class="mb-0">
        En esta <strong>Versión 2</strong> se gestiona la administración (CRUD) de la tabla puente <code>rutarol</code>.
        <strong>La puerta de seguridad, tokens, sesiones, HTTP 401 y HTTP 403 corresponden a la Versión 3.</strong>
        Aquí se configuran los permisos; en la v3 se harán valer.
    </p>
</div>

@* Muestra alerta si la API no responde o si el rol carece de permisos (403 Forbidden) *@
@if (errorConexion)
{
    <div class="alert alert-danger aviso-desconexion mb-4 shadow-sm" role="alert">
        <h4 class="alert-heading">⚠️ Error de conexión con la API</h4>
        <p class="mb-1">No se pudo establecer comunicación con el servicio en <code>/api/rutarol</code>.</p>
        <button class="btn btn-outline-danger btn-sm mt-3" @onclick="CargarDatos">Reintentar conexión</button>
    </div>
}

@if (!string.IsNullOrEmpty(mensajeAlerta))
{
    <div class="alert @(esExito ? "alert-success" : "alert-warning") alert-dismissible fade show shadow-sm" role="alert">
        <strong>@(esExito ? "✔ Operación exitosa:" : "⚠️ Atención:")</strong> @mensajeAlerta
        <button type="button" class="btn-close float-end" @onclick="() => mensajeAlerta = null">X</button>
    </div>
}

<div class="row">
    <!-- Formulario para Asignar Pareja -->
    <div class="col-12 col-lg-5 mb-4">
        <div class="tarjeta">
            <div class="tarjeta-header">
                <span class="fw-bold">Asignar Acceso a Ruta</span>
            </div>
            <div class="tarjeta-body">
                <div class="mb-3">
                    <label class="form-label">Ruta del Sistema</label>
                    <!-- Selector dinámico alimentado por la API para elegir claves foráneas por nombre (Versión 2) -->
                    <select class="form-select" @bind="rutaSeleccionadaId">
                        <option value="0">-- Seleccione una Ruta --</option>
                        @* Recorre cada registro de la colección para renderizar dinámicamente filas o tarjetas *@
                        @foreach (var rt in listaRutas)
                        {
                            <option value="@rt.Id">@rt.NombreRuta — @rt.Descripcion</option>
                        }
                    </select>
                </div>

                <div class="mb-3">
                    <label class="form-label">Rol Autorizado</label>
                    <!-- Selector dinámico alimentado por la API para elegir claves foráneas por nombre (Versión 2) -->
                    <select class="form-select" @bind="rolSeleccionadoId">
                        <option value="0">-- Seleccione un Rol --</option>
                        @* Recorre cada registro de la colección para renderizar dinámicamente filas o tarjetas *@
                        @foreach (var rl in listaRoles)
                        {
                            <option value="@rl.Id">@rl.Nombre (ID: @rl.Id)</option>
                        }
                    </select>
                </div>

                <button class="btn btn-primary w-100 mt-2" @onclick="AsignarPermiso"
                        disabled="@(rutaSeleccionadaId == 0 || rolSeleccionadoId == 0)">
                    Asignar Permiso (POST)
                </button>
            </div>
        </div>
    </div>

    <!-- Tabla de Permisos Actuales -->
    <div class="col-12 col-lg-7">
        <div class="tarjeta">
            <div class="tarjeta-header d-flex justify-content-between align-items-center">
                <span class="fw-bold">Matriz de Acceso Configurada (@listaPermisos.Count)</span>
                <button class="btn btn-sm btn-outline-primary" @onclick="CargarDatos">Actualizar</button>
            </div>
            <div class="tarjeta-body p-0">
                <div class="table-responsive">
                    <!-- Tabla Bootstrap responsiva para mostrar el listado de registros de la API -->
                    <table class="table table-hover align-middle mb-0">
                        <thead class="table-light">
                            <tr>
                                <th>Ruta</th>
                                <th>Rol Autorizado</th>
                                <th class="text-end">Acción</th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (listaPermisos.Count == 0)
                            {
                                <tr>
                                    <td colspan="3" class="text-center text-muted py-4">
                                        No hay permisos registrados en la tabla puente rutarol.
                                    </td>
                                </tr>
                            }
                            else
                            {
                                @* Recorre cada registro de la colección para renderizar dinámicamente filas o tarjetas *@
                                @foreach (var p in listaPermisos)
                                {
                                    <tr>
                                        <td><code>@p.Ruta</code></td>
                                        <td><span class="badge bg-secondary">@p.Rol</span></td>
                                        <td class="text-end">
                                            <!-- Quitar exige ambas claves (idruta e idrol) -->
                                            <button class="btn btn-outline-danger btn-sm" @onclick="() => QuitarPermiso(p.Fkidruta, p.Fkidrol)">
                                                Revocar
                                            </button>
                                        </td>
                                    </tr>
                                }
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</div>

@* Lógica C# del componente: estado en memoria, llamadas HTTP y manejo de eventos *@
@code {
    private List<RutaRol> listaPermisos = new();
    private List<Ruta> listaRutas = new();
    private List<Rol> listaRoles = new();

    private int rutaSeleccionadaId = 0;
    private int rolSeleccionadoId = 0;

    private bool errorConexion = false;
    private string? mensajeAlerta;
    private bool esExito = false;

    protected override async Task OnInitializedAsync()
    {
        await CargarDatos();
    }

    // Consulta los datos desde la API manejando errores de red o falta de permisos (401/403)
    private async Task CargarDatos()
    {
        errorConexion = false;
        mensajeAlerta = null;
        // Bloque try: ejecuta la operación capturando excepciones de negocio, SQL o red para responder adecuadamente
        try
        {
            var tareaPermisos = ServicioRutaRol.ListarAsync();
            var tareaRutas = ServicioRuta.ListarAsync();
            var tareaRoles = ServicioRol.ListarAsync();

            await Task.WhenAll(tareaPermisos, tareaRutas, tareaRoles);

            listaPermisos = await tareaPermisos;
            listaRutas = await tareaRutas;
            listaRoles = await tareaRoles;
        }
        catch
        {
            errorConexion = true;
        }
    }

    // Ejecuta la operación 'AsignarPermiso' dentro de la capa correspondiente
    private async Task AsignarPermiso()
    {
        mensajeAlerta = null;

        var resultado = await ServicioRutaRol.AsignarAsync(rutaSeleccionadaId, rolSeleccionadoId);
        esExito = resultado.Exitoso;
        mensajeAlerta = resultado.Mensaje;

        if (resultado.Exitoso)
        {
            rutaSeleccionadaId = 0;
            rolSeleccionadoId = 0;
            await CargarDatos();
        }
    }

    // Ejecuta la operación 'QuitarPermiso' dentro de la capa correspondiente
    private async Task QuitarPermiso(int idRuta, int idRol)
    {
        mensajeAlerta = null;

        var resultado = await ServicioRutaRol.QuitarAsync(idRuta, idRol);
        esExito = resultado.Exitoso;
        mensajeAlerta = resultado.Mensaje;

        if (resultado.Exitoso)
        {
            await CargarDatos();
        }
    }
}

