@* Ruta URL en Blazor que renderiza esta página: '/usuarios' *@
@page "/usuarios"
@* Inyección de dependencia 'ServicioUsuario' disponible bajo la variable 'ServicioUsuario' *@
@inject ServicioUsuario ServicioUsuario
@* Activa el modo interactivo en servidor (SignalR/WebSocket) para eventos sin recargar la página *@
@rendermode InteractiveServer

<PageTitle>Usuarios — Sistema de Facturación v1</PageTitle>

<div class="d-flex justify-content-between align-items-center mb-4">
    <h2>Gestión de Usuarios</h2>
    <span class="badge bg-secondary">Recurso: /usuarios</span>
</div>

@* Muestra alerta si la API no responde o si el rol carece de permisos (403 Forbidden) *@
@if (errorConexion)
{
    <div class="alert alert-danger aviso-desconexion mb-4 shadow-sm" role="alert">
        <h4 class="alert-heading">⚠️ Error de conexión con la API</h4>
        <p class="mb-1">No se pudo establecer comunicación con el servicio en <code>/api/usuario</code>.</p>
        <button class="btn btn-outline-danger btn-sm mt-3" @onclick="CargarUsuarios">Reintentar conexión</button>
    </div>
}

@if (!string.IsNullOrEmpty(mensajeAlerta))
{
    <div class="alert @(esExito ? "alert-success" : "alert-warning") alert-dismissible fade show shadow-sm" role="alert">
        <strong>@(esExito ? "✔ Operación exitosa:" : "⚠️ Atención:")</strong> @mensajeAlerta
        @if (listaErroresValidacion != null && listaErroresValidacion.Count > 0)
        {
            <ul class="mb-0 mt-2">
                @* Recorre cada registro de la colección para renderizar dinámicamente filas o tarjetas *@
                @foreach (var err in listaErroresValidacion)
                {
                    <li>@err</li>
                }
            </ul>
        }
        <button type="button" class="btn-close float-end" @onclick="() => mensajeAlerta = null">X</button>
    </div>
}

<div class="row">
    <div class="col-12 col-lg-5 mb-4">
        <div class="tarjeta">
            <div class="tarjeta-header d-flex justify-content-between align-items-center">
                <span class="fw-bold">@(modoEdicion ? "Modificar Contraseña" : "Nuevo Usuario")</span>
                @if (modoEdicion)
                {
                    <button class="btn btn-outline-secondary btn-sm" @onclick="CancelarEdicion">Cancelar</button>
                }
            </div>
            <div class="tarjeta-body">
                <div class="mb-3">
                    <label class="form-label">Correo electrónico (Clave primaria)</label>
                    <input type="email" class="form-control" placeholder="Ej: usuario@correo.com"
                           @bind="formularioUsuario.Email"
                           disabled="@modoEdicion" />
                    <small class="text-muted">El correo electrónico identifica unívocamente al usuario.</small>
                </div>

                <div class="mb-3">
                    <label class="form-label">@(modoEdicion ? "Nueva Contraseña" : "Contraseña")</label>
                    <input type="password" class="form-control" placeholder="Mínimo 4 caracteres"
                           @bind="formularioUsuario.Contrasena" />
                    <small class="text-muted">En la v1 la clave viaja en texto plano; el hash con BCrypt llega en la v3.</small>
                </div>

                <div class="acciones mt-4">
                    @if (!modoEdicion)
                    {
                        <button class="btn btn-success" @onclick="CrearUsuario" disabled="@cargando">
                            Crear usuario
                        </button>
                    }
                    else
                    {
                        <button class="btn btn-primary" @onclick="GuardarFichaCompleta" disabled="@cargando">
                            Guardar la ficha completa
                        </button>
                        <button class="btn btn-secondary" @onclick="GuardarSoloLoCambiado" disabled="@cargando">
                            Guardar solo lo que cambié
                        </button>
                    }
                </div>
            </div>
        </div>
    </div>

    <div class="col-12 col-lg-7 mb-4">
        <div class="tarjeta">
            <div class="tarjeta-header d-flex justify-content-between align-items-center">
                <span class="fw-bold">Listado de Cuentas de Usuario</span>
                <span class="badge bg-primary">Total: @listaUsuarios.Count</span>
            </div>
            <div class="tarjeta-body p-0">
                @if (cargando)
                {
                    <div class="p-4 text-center text-muted"><em>Cargando usuarios...</em></div>
                }
                else if (listaUsuarios.Count == 0 && !errorConexion)
                {
                    <div class="p-4 text-center text-muted"><em>No hay usuarios registrados (HTTP 204).</em></div>
                }
                else if (!errorConexion)
                {
                    <div class="table-responsive">
                        <!-- Tabla Bootstrap responsiva para mostrar el listado de registros de la API -->
                        <table class="table table-striped table-hover mb-0 align-middle">
                            <thead class="table-light">
                                <tr>
                                    <th>Email / Usuario</th>
                                    <th class="text-center">Acciones</th>
                                </tr>
                            </thead>
                            <tbody>
                                @* Recorre cada registro de la colección para renderizar dinámicamente filas o tarjetas *@
                                @foreach (var u in listaUsuarios)
                                {
                                    <tr>
                                        <td><strong>@u.Email</strong></td>
                                        <td class="text-center">
                                            <div class="btn-group btn-group-sm">
                                                <button class="btn btn-outline-primary" @onclick="() => CargarEnEdicion(u)">Cambiar clave</button>
                                                <button class="btn btn-outline-danger" @onclick="() => EliminarUsuario(u.Email)">Borrar</button>
                                            </div>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
            </div>
        </div>
    </div>
</div>

@* Lógica C# del componente: estado en memoria, llamadas HTTP y manejo de eventos *@
@code {
    private List<Usuario> listaUsuarios = new();
    private Usuario formularioUsuario = new();
    private string contrasenaOriginalEdicion = string.Empty;

    private bool modoEdicion = false;
    private bool cargando = false;
    private bool errorConexion = false;
    private bool esExito = false;
    private string? mensajeAlerta;
    private List<string>? listaErroresValidacion;

    protected override async Task OnInitializedAsync()
    {
        await CargarUsuarios();
    }

    // Consulta los datos desde la API manejando errores de red o falta de permisos (401/403)
    private async Task CargarUsuarios()
    {
        cargando = true;
        errorConexion = false;
        // Bloque try: ejecuta la operación capturando excepciones de negocio, SQL o red para responder adecuadamente
        try
        {
            listaUsuarios = await ServicioUsuario.ListarAsync();
        }
        // Captura falla de red o API apagada en el frontend para evitar caída y mostrar alerta
        catch (HttpRequestException ex) when (ex.StatusCode == System.Net.HttpStatusCode.Forbidden)
        {
            // Criterio 9 (Versión 3): Si escribe la URL a mano sin permiso, aviso de 403 y CERO filas
            mensajeAlerta = "Su rol no tiene permiso para esta operacion.";
            esExito = false;
            listaUsuarios = new List<Usuario>();
        }
        // Captura falla de red o API apagada en el frontend para evitar caída y mostrar alerta
        catch (HttpRequestException ex) when (ex.StatusCode == System.Net.HttpStatusCode.Unauthorized)
        {
            mensajeAlerta = "No hay una sesion valida. Debe iniciar sesion.";
            esExito = false;
            listaUsuarios = new List<Usuario>();
        }
        catch
        {
            errorConexion = true;
            listaUsuarios = new List<Usuario>();
        }
        finally
        {
            cargando = false;
        }
    }

    // Valida los datos de entrada y registra una nueva entidad en el sistema
    private async Task CrearUsuario()
    {
        cargando = true;
        mensajeAlerta = null;
        listaErroresValidacion = null;

        var resultado = await ServicioUsuario.CrearAsync(formularioUsuario);
        if (resultado.Exitoso)
        {
            esExito = true;
            mensajeAlerta = resultado.Mensaje;
            formularioUsuario = new Usuario();
            await CargarUsuarios();
        }
        else
        {
            esExito = false;
            mensajeAlerta = resultado.Mensaje;
            listaErroresValidacion = resultado.ErroresValidacion;
        }

        cargando = false;
    }

    // Carga los datos de la fila seleccionada en el formulario para permitir edición PUT o PATCH
    private void CargarEnEdicion(Usuario u)
    {
        modoEdicion = true;
        mensajeAlerta = null;
        listaErroresValidacion = null;

        contrasenaOriginalEdicion = string.Empty;
        formularioUsuario = new Usuario
        {
            Email = u.Email,
            Contrasena = string.Empty
        };
    }

    // Limpia el formulario actual y regresa al modo de creación
    private void CancelarEdicion()
    {
        modoEdicion = false;
        formularioUsuario = new Usuario();
        contrasenaOriginalEdicion = string.Empty;
        mensajeAlerta = null;
        listaErroresValidacion = null;
    }

    // Envía petición PUT a la API para reemplazar toda la ficha del registro
    private async Task GuardarFichaCompleta()
    {
        cargando = true;
        mensajeAlerta = null;
        listaErroresValidacion = null;

        var resultado = await ServicioUsuario.GuardarFichaCompletaAsync(formularioUsuario);
        if (resultado.Exitoso)
        {
            esExito = true;
            mensajeAlerta = resultado.Mensaje;
            CancelarEdicion();
            await CargarUsuarios();
        }
        else
        {
            esExito = false;
            mensajeAlerta = resultado.Mensaje;
            listaErroresValidacion = resultado.ErroresValidacion;
        }

        cargando = false;
    }

    // Envía petición PATCH a la API únicamente con los campos editados
    private async Task GuardarSoloLoCambiado()
    {
        cargando = true;
        mensajeAlerta = null;
        listaErroresValidacion = null;

        var cambios = new Dictionary<string, object>();
        if (!string.IsNullOrWhiteSpace(formularioUsuario.Contrasena))
        {
            cambios["contrasena"] = formularioUsuario.Contrasena;
        }

        if (cambios.Count == 0)
        {
            esExito = false;
            mensajeAlerta = "No se detectaron cambios en la contraseña.";
            cargando = false;
            return;
        }

        var resultado = await ServicioUsuario.GuardarSoloLoCambiadoAsync(formularioUsuario.Email, cambios);
        if (resultado.Exitoso)
        {
            esExito = true;
            mensajeAlerta = resultado.Mensaje;
            CancelarEdicion();
            await CargarUsuarios();
        }
        else
        {
            esExito = false;
            mensajeAlerta = resultado.Mensaje;
            listaErroresValidacion = resultado.ErroresValidacion;
        }

        cargando = false;
    }

    // Elimina el registro especificado validando su existencia previa
    private async Task EliminarUsuario(string email)
    {
        cargando = true;
        mensajeAlerta = null;

        var resultado = await ServicioUsuario.EliminarAsync(email);
        if (resultado.Exitoso)
        {
            esExito = true;
            mensajeAlerta = resultado.Mensaje;
            if (modoEdicion && formularioUsuario.Email == email)
            {
                CancelarEdicion();
            }
            await CargarUsuarios();
        }
        else
        {
            esExito = false;
            mensajeAlerta = resultado.Mensaje;
        }

        cargando = false;
    }
}

