@* Ruta URL en Blazor que renderiza esta página: '/facturas' *@
@page "/facturas"
@* Inyección de dependencia 'ServicioFactura' disponible bajo la variable 'ServicioFactura' *@
@inject ServicioFactura ServicioFactura
@* Inyección de dependencia 'NavigationManager' disponible bajo la variable 'Navigation' *@
@inject NavigationManager Navigation
@* Activa el modo interactivo en servidor (SignalR/WebSocket) para eventos sin recargar la página *@
@rendermode InteractiveServer

<PageTitle>Facturas — Sistema de Facturación v2</PageTitle>

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h2>Historial de Facturas</h2>
        <span class="badge bg-primary">Maestro-Detalle · Procedimientos Almacenados</span>
    </div>
    <a href="/facturas/nueva" class="btn btn-primary">
        + Emitir Nueva Factura
    </a>
</div>

@* Muestra alerta si la API no responde o si el rol carece de permisos (403 Forbidden) *@
@if (errorConexion)
{
    <div class="alert alert-danger aviso-desconexion mb-4 shadow-sm" role="alert">
        <h4 class="alert-heading">⚠️ Error de conexión con la API</h4>
        <p class="mb-1">No se pudo establecer comunicación con el servicio en <code>/api/factura</code>.</p>
        <button class="btn btn-outline-danger btn-sm mt-3" @onclick="CargarFacturas">Reintentar conexión</button>
    </div>
}

@if (!string.IsNullOrEmpty(mensajeAlerta))
{
    <div class="alert @(esExito ? "alert-success" : "alert-warning") alert-dismissible fade show shadow-sm" role="alert">
        <strong>@(esExito ? "✔ Operación exitosa:" : "⚠️ Atención:")</strong> @mensajeAlerta
        <button type="button" class="btn-close float-end" @onclick="() => mensajeAlerta = null">X</button>
    </div>
}

<div class="tarjeta">
    <div class="tarjeta-header d-flex justify-content-between align-items-center">
        <span class="fw-bold">Listado de Facturas Emitidas</span>
        <button class="btn btn-sm btn-outline-primary" @onclick="CargarFacturas">Actualizar</button>
    </div>
    <div class="tarjeta-body p-0">
        <div class="table-responsive">
            <!-- Tabla Bootstrap responsiva para mostrar el listado de registros de la API -->
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th>Número</th>
                        <th>Fecha</th>
                        <th>Cliente</th>
                        <th>Vendedor</th>
                        <th>Total</th>
                        <th>Estado</th>
                        <th>Detalle</th>
                        <th class="text-end">Acciones</th>
                    </tr>
                </thead>
                <tbody>
                    @if (listaFacturas.Count == 0)
                    {
                        <tr>
                            <td colspan="8" class="text-center text-muted py-4">
                                No se encontraron facturas registradas.
                            </td>
                        </tr>
                    }
                    else
                    {
                        @* Recorre cada registro de la colección para renderizar dinámicamente filas o tarjetas *@
                        @foreach (var f in listaFacturas)
                        {
                            <tr>
                                <td><strong>#@f.Numero</strong></td>
                                <td>@f.Fecha.ToString("yyyy-MM-dd HH:mm")</td>
                                <td>@(f.NombreCliente ?? $"Cliente #{f.Fkidcliente}")</td>
                                <td>@(f.NombreVendedor ?? $"Vendedor #{f.Fkidvendedor}")</td>
                                <td><strong class="text-success">@f.Total.ToString("C0")</strong></td>
                                <td>
                                    @if (f.Estado.ToLower() == "activa")
                                    {
                                        <span class="badge bg-success">Activa</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-danger">Anulada</span>
                                    }
                                </td>
                                <td>
                                    <button class="btn btn-outline-secondary btn-sm" @onclick="() => AlternarDetalle(f.Numero)">
                                        @(facturaExpandida == f.Numero ? "Ocultar" : $"Ver ({f.Productos.Count} productos)")
                                    </button>
                                    <a href="/facturas/@f.Numero" class="btn btn-outline-info btn-sm ms-1">
                                        Ficha
                                    </a>
                                </td>
                                <td class="text-end">
                                    <!-- Criterio 15: NO existe botón eliminar; existe botón ANULAR que devuelve el stock -->
                                    @if (f.Estado.ToLower() == "activa")
                                    {
                                        <button class="btn btn-outline-danger btn-sm" @onclick="() => AnularFactura(f.Numero)">
                                            Anular Factura
                                        </button>
                                    }
                                    else
                                    {
                                        <span class="text-muted small">Sin acciones</span>
                                    }
                                </td>
                            </tr>
                            @if (facturaExpandida == f.Numero)
                            {
                                <tr class="table-light">
                                    <td colspan="8" class="p-3">
                                        <div class="card p-3 shadow-sm border-0">
                                            <h6 class="fw-bold mb-3">Detalle de Productos (Factura #@f.Numero)</h6>
                                            <!-- Tabla Bootstrap responsiva para mostrar el listado de registros de la API -->
                                            <table class="table table-sm table-bordered bg-white mb-0">
                                                <thead class="table-secondary">
                                                    <tr>
                                                        <th>Código</th>
                                                        <th>Producto</th>
                                                        <th class="text-center">Cantidad</th>
                                                        <th class="text-end">Valor Unitario</th>
                                                        <th class="text-end">Subtotal</th>
                                                    </tr>
                                                </thead>
                                                <tbody>
                                                    @* Recorre cada registro de la colección para renderizar dinámicamente filas o tarjetas *@
                                                    @foreach (var prod in f.Productos)
                                                    {
                                                        <tr>
                                                            <td><code>@prod.CodigoProducto</code></td>
                                                            <td>@(prod.NombreProducto ?? prod.CodigoProducto)</td>
                                                            <td class="text-center">@prod.Cantidad</td>
                                                            <td class="text-end">@prod.ValorUnitario.ToString("C0")</td>
                                                            <td class="text-end"><strong>@prod.Subtotal.ToString("C0")</strong></td>
                                                        </tr>
                                                    }
                                                </tbody>
                                            </table>
                                        </div>
                                    </td>
                                </tr>
                            }
                        }
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

@* Lógica C# del componente: estado en memoria, llamadas HTTP y manejo de eventos *@
@code {
    private List<Factura> listaFacturas = new();
    private int? facturaExpandida = null;
    private bool errorConexion = false;
    private string? mensajeAlerta;
    private bool esExito = false;

    protected override async Task OnInitializedAsync()
    {
        await CargarFacturas();
    }

    // Consulta los datos desde la API manejando errores de red o falta de permisos (401/403)
    private async Task CargarFacturas()
    {
        errorConexion = false;
        mensajeAlerta = null;
        // Bloque try: ejecuta la operación capturando excepciones de negocio, SQL o red para responder adecuadamente
        try
        {
            listaFacturas = await ServicioFactura.ListarAsync();
        }
        // Captura falla de red o API apagada en el frontend para evitar caída y mostrar alerta
        catch (HttpRequestException ex) when (ex.StatusCode == System.Net.HttpStatusCode.Forbidden)
        {
            mensajeAlerta = "Su rol no tiene permiso para esta operacion.";
            esExito = false;
            listaFacturas = new();
        }
        // Captura falla de red o API apagada en el frontend para evitar caída y mostrar alerta
        catch (HttpRequestException ex) when (ex.StatusCode == System.Net.HttpStatusCode.Unauthorized)
        {
            mensajeAlerta = "No hay una sesion valida. Debe iniciar sesion.";
            esExito = false;
            listaFacturas = new();
        }
        catch
        {
            errorConexion = true;
        }
    }

    // Ejecuta la operación 'AlternarDetalle' dentro de la capa correspondiente
    private void AlternarDetalle(int numero)
    {
        facturaExpandida = facturaExpandida == numero ? null : numero;
    }

    // Anula lógicamente la factura en SQL Server devolviendo el stock al inventario
    private async Task AnularFactura(int numero)
    {
        mensajeAlerta = null;
        var resultado = await ServicioFactura.AnularAsync(numero);
        esExito = resultado.Exitoso;
        mensajeAlerta = resultado.Mensaje;

        if (resultado.Exitoso)
        {
            await CargarFacturas();
        }
    }
}
