@page "/usuarios-y-roles"
@page "/usuario-con-roles"
@inject ServicioUsuarioConRoles ServicioUsuarioConRoles
@inject ServicioRol ServicioRol
@rendermode InteractiveServer

<PageTitle>Usuarios y Roles — Sistema de Facturación v2</PageTitle>

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h2>Usuarios y Roles</h2>
        <span class="badge bg-primary">Recurso Compuesto (RF5 · 3_plan.md 3.5)</span>
    </div>
</div>

@if (errorConexion)
{
    <div class="alert alert-danger aviso-desconexion mb-4 shadow-sm" role="alert">
        <h4 class="alert-heading">⚠️ Error de conexión con la API</h4>
        <p class="mb-1">No se pudo establecer comunicación con el servicio en <code>/api/usuario-con-roles</code>.</p>
        <button class="btn btn-outline-danger btn-sm mt-3" @onclick="CargarDatos">Reintentar conexión</button>
    </div>
}

@if (!string.IsNullOrEmpty(mensajeAlerta))
{
    <div class="alert @(esExito ? "alert-success" : "alert-warning") alert-dismissible fade show shadow-sm" role="alert">
        <strong>@(esExito ? "✔ Operación exitosa:" : "⚠️ Atención:")</strong> @mensajeAlerta
        @if (listaErroresValidacion != null && listaErroresValidacion.Count > 0)
        {
            <ul class="mb-0 mt-2">
                @foreach (var err in listaErroresValidacion)
                {
                    <li>@err</li>
                }
            </ul>
        }
        <button type="button" class="btn-close float-end" @onclick="() => mensajeAlerta = null">X</button>
    </div>
}

<div class="row">
    <!-- Formulario de Creación / Edición Integrada (Criterios 16 y 17) -->
    <div class="col-12 col-lg-5 mb-4">
        <div class="tarjeta">
            <div class="tarjeta-header d-flex justify-content-between align-items-center">
                <span class="fw-bold">@(modoEdicion ? "Editar Usuario y Roles" : "Nuevo Usuario con Roles")</span>
                @if (modoEdicion)
                {
                    <button class="btn btn-outline-secondary btn-sm" @onclick="CancelarEdicion">Cancelar</button>
                }
            </div>
            <div class="tarjeta-body">
                <div class="mb-3">
                    <label class="form-label">Correo Electrónico (Email)</label>
                    <input type="email" class="form-control" placeholder="ejemplo@correo.com"
                           @bind="formularioEmail" disabled="@modoEdicion" />
                    @if (modoEdicion)
                    {
                        <small class="text-muted">El correo actúa como clave primaria y no puede modificarse.</small>
                    }
                </div>

                <!-- Criterio 17: Contraseña vacía conserva la anterior -->
                <div class="mb-3">
                    <label class="form-label">Contraseña</label>
                    <input type="password" class="form-control" placeholder="@(modoEdicion ? "Dejar en blanco para conservar clave actual" : "Contraseña de acceso")"
                           @bind="formularioContrasena" />
                    @if (modoEdicion)
                    {
                        <small class="text-info">
                            ℹ️ Si deja este campo vacío, la base de datos conservará la contraseña actual sin alterarla.
                        </small>
                    }
                </div>

                <!-- Criterio 16: Casillas de verificación para roles -->
                <div class="mb-3">
                    <label class="form-label d-block fw-bold">Roles Asignados</label>
                    @if (catalogoRoles.Count == 0)
                    {
                        <p class="text-muted small">No hay roles configurados en la tabla 'rol'.</p>
                    }
                    else
                    {
                        <div class="border rounded p-3 bg-light">
                            @foreach (var rol in catalogoRoles)
                            {
                                <div class="form-check mb-2">
                                    <input class="form-check-input" type="checkbox" id="@($"rol_chk_{rol.Id}")"
                                           checked="@rolesSeleccionados.Contains(rol.Id)"
                                           @onchange="(e) => AlternarRol(rol.Id, e.Value)" />
                                    <label class="form-check-label" for="@($"rol_chk_{rol.Id}")">
                                        <strong>@rol.Nombre</strong> <span class="text-muted">(ID: @rol.Id)</span>
                                    </label>
                                </div>
                            }
                        </div>
                        <small class="text-muted">Marque las casillas de los roles que pertenecerán al usuario.</small>
                    }
                </div>

                <div class="mt-4">
                    @if (!modoEdicion)
                    {
                        <button class="btn btn-primary w-100" @onclick="CrearUsuarioConRoles">
                            Crear Usuario con Roles (POST)
                        </button>
                    }
                    else
                    {
                        <button class="btn btn-success w-100" @onclick="GuardarUsuarioConRoles">
                            Guardar Usuario y Roles (PUT)
                        </button>
                    }
                </div>
            </div>
        </div>
    </div>

    <!-- Tabla de Consulta y Listado -->
    <div class="col-12 col-lg-7">
        <div class="tarjeta">
            <div class="tarjeta-header d-flex justify-content-between align-items-center">
                <span class="fw-bold">Usuarios Registrados y sus Roles</span>
                <button class="btn btn-sm btn-outline-primary" @onclick="CargarDatos">Actualizar</button>
            </div>
            <div class="tarjeta-body p-0">
                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0">
                        <thead class="table-light">
                            <tr>
                                <th>Usuario (Email)</th>
                                <th>Roles Asignados</th>
                                <th class="text-end">Acciones</th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (listaUsuarios.Count == 0)
                            {
                                <tr>
                                    <td colspan="3" class="text-center text-muted py-4">
                                        No se encontraron usuarios registrados.
                                    </td>
                                </tr>
                            }
                            else
                            {
                                @foreach (var u in listaUsuarios)
                                {
                                    <tr>
                                        <td><strong>@u.Email</strong></td>
                                        <td>
                                            @if (u.Roles.Count == 0)
                                            {
                                                <span class="badge bg-warning text-dark">Sin roles</span>
                                            }
                                            else
                                            {
                                                @foreach (var r in u.Roles)
                                                {
                                                    <span class="badge bg-primary me-1">@r.Nombre</span>
                                                }
                                            }
                                        </td>
                                        <td class="text-end">
                                            <button class="btn btn-outline-primary btn-sm me-1" @onclick="() => IniciarEdicion(u)">
                                                Editar
                                            </button>
                                            <button class="btn btn-outline-danger btn-sm" @onclick="() => EliminarUsuario(u.Email)">
                                                Eliminar
                                            </button>
                                        </td>
                                    </tr>
                                }
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</div>

@code {
    private List<UsuarioConRoles> listaUsuarios = new();
    private List<Rol> catalogoRoles = new();

    private string formularioEmail = string.Empty;
    private string formularioContrasena = string.Empty;
    private HashSet<int> rolesSeleccionados = new();

    private bool modoEdicion = false;
    private bool errorConexion = false;
    private string? mensajeAlerta;
    private bool esExito = false;
    private List<string>? listaErroresValidacion;

    protected override async Task OnInitializedAsync()
    {
        await CargarDatos();
    }

    private async Task CargarDatos()
    {
        errorConexion = false;
        mensajeAlerta = null;
        try
        {
            var tareaUsuarios = ServicioUsuarioConRoles.ListarAsync();
            var tareaRoles = ServicioRol.ListarAsync();

            await Task.WhenAll(tareaUsuarios, tareaRoles);

            listaUsuarios = await tareaUsuarios;
            catalogoRoles = await tareaRoles;
        }
        catch
        {
            errorConexion = true;
        }
    }

    private void AlternarRol(int idRol, object? valorCheck)
    {
        bool seleccionado = valorCheck is bool b && b;
        if (seleccionado)
        {
            rolesSeleccionados.Add(idRol);
        }
        else
        {
            rolesSeleccionados.Remove(idRol);
        }
    }

    private async Task CrearUsuarioConRoles()
    {
        mensajeAlerta = null;
        listaErroresValidacion = null;

        if (string.IsNullOrWhiteSpace(formularioEmail))
        {
            mensajeAlerta = "El correo electrónico es obligatorio.";
            esExito = false;
            return;
        }

        if (string.IsNullOrWhiteSpace(formularioContrasena))
        {
            mensajeAlerta = "La contraseña es obligatoria en la creación.";
            esExito = false;
            return;
        }

        var resultado = await ServicioUsuarioConRoles.CrearAsync(
            formularioEmail.Trim(),
            formularioContrasena,
            rolesSeleccionados.ToList()
        );

        esExito = resultado.Exitoso;
        mensajeAlerta = resultado.Mensaje;
        listaErroresValidacion = resultado.ErroresValidacion;

        if (resultado.Exitoso)
        {
            formularioEmail = string.Empty;
            formularioContrasena = string.Empty;
            rolesSeleccionados.Clear();
            await CargarDatos();
        }
    }

    private void IniciarEdicion(UsuarioConRoles u)
    {
        modoEdicion = true;
        formularioEmail = u.Email;
        formularioContrasena = string.Empty;
        rolesSeleccionados = new HashSet<int>(u.Roles.Select(r => r.IdRol));
        mensajeAlerta = null;
        listaErroresValidacion = null;
    }

    private void CancelarEdicion()
    {
        modoEdicion = false;
        formularioEmail = string.Empty;
        formularioContrasena = string.Empty;
        rolesSeleccionados.Clear();
        mensajeAlerta = null;
        listaErroresValidacion = null;
    }

    private async Task GuardarUsuarioConRoles()
    {
        mensajeAlerta = null;
        listaErroresValidacion = null;

        var resultado = await ServicioUsuarioConRoles.ActualizarAsync(
            formularioEmail,
            formularioContrasena,
            rolesSeleccionados.ToList()
        );

        esExito = resultado.Exitoso;
        mensajeAlerta = resultado.Mensaje;
        listaErroresValidacion = resultado.ErroresValidacion;

        if (resultado.Exitoso)
        {
            CancelarEdicion();
            await CargarDatos();
        }
    }

    private async Task EliminarUsuario(string email)
    {
        if (modoEdicion && formularioEmail == email)
        {
            CancelarEdicion();
        }

        var resultado = await ServicioUsuarioConRoles.EliminarAsync(email);
        esExito = resultado.Exitoso;
        mensajeAlerta = resultado.Mensaje;
        listaErroresValidacion = resultado.ErroresValidacion;

        if (resultado.Exitoso)
        {
            await CargarDatos();
        }
    }
}

