@page "/sesion"
@page "/login"
@inject FrontFacturas.Servicios.ServicioSesion ServicioSesion
@inject FrontFacturas.Servicios.EstadoSesion EstadoSesion
@inject NavigationManager Navigation

<PageTitle>Iniciar Sesión — Versión 3</PageTitle>

<div class="row justify-content-center mt-4">
    <div class="col-md-6 col-lg-5">
        <div class="card shadow-sm border-0">
            <div class="card-header bg-primary text-white text-center py-3">
                <h4 class="mb-0">Control de Acceso (Versión 3)</h4>
                <small>Autenticación con JWT Bearer y RBAC</small>
            </div>
            <div class="card-body p-4">
                @if (EstadoSesion.EstaAutenticado)
                {
                    <div class="alert alert-success text-center">
                        <h5>¡Ya has iniciado sesión!</h5>
                        <p class="mb-1">Conectado como: <strong>@EstadoSesion.Email</strong></p>
                        <p class="text-muted small">Roles: @string.Join(", ", EstadoSesion.Roles)</p>
                        <div class="mt-3">
                            <a href="/" class="btn btn-outline-primary me-2">Ir al inicio</a>
                            <button class="btn btn-danger" @onclick="Cerrar">Cerrar sesión</button>
                        </div>
                    </div>
                }
                else
                {
                    @if (!string.IsNullOrWhiteSpace(_errorMensaje))
                    {
                        <div class="alert alert-danger d-flex align-items-center" role="alert">
                            <div>
                                <strong>Error de autenticación:</strong> @_errorMensaje
                            </div>
                        </div>
                    }

                    <form @onsubmit="IniciarSesion">
                        <div class="mb-3">
                            <label class="form-label font-weight-bold">Correo Electrónico:</label>
                            <input type="email" class="form-control" @bind="_email" placeholder="ej: admin@correo.com" required autofocus />
                        </div>
                        <div class="mb-3">
                            <label class="form-label font-weight-bold">Contraseña:</label>
                            <input type="password" class="form-control" @bind="_contrasena" placeholder="Tu contraseña" required />
                        </div>
                        <div class="d-grid gap-2 mt-4">
                            <button type="submit" class="btn btn-primary btn-lg" disabled="@_cargando">
                                @if (_cargando)
                                {
                                    <span class="spinner-border spinner-border-sm me-2" role="status"></span>
                                    <span>Verificando...</span>
                                }
                                else
                                {
                                    <span>Ingresar al Sistema</span>
                                }
                            </button>
                        </div>
                    </form>

                    <hr class="my-4" />

                    <div class="bg-light p-3 rounded border">
                        <h6 class="text-secondary mb-2">Credenciales de Prueba (Quickstart):</h6>
                        <ul class="list-unstyled small mb-0">
                            <li><strong>Admin:</strong> <code>admin@correo.com</code> / <code>admin123</code> <span class="badge bg-success">15 rutas</span></li>
                            <li><strong>Vendedor:</strong> <code>vendedor1@correo.com</code> / <code>vendedor123</code> <span class="badge bg-warning text-dark">Facturas, Clientes</span></li>
                            <li><strong>Cliente:</strong> <code>cliente1@correo.com</code> / <code>cliente123</code> <span class="badge bg-info text-dark">Productos</span></li>
                        </ul>
                    </div>
                }
            </div>
        </div>
    </div>
</div>

@code {
    private string _email = "";
    private string _contrasena = "";
    private string? _errorMensaje;
    private bool _cargando;

    private async Task IniciarSesion()
    {
        _errorMensaje = null;
        _cargando = true;

        try
        {
            var (exito, mensaje) = await ServicioSesion.IniciarSesionAsync(_email, _contrasena);
            if (exito)
            {
                Navigation.NavigateTo("/");
            }
            else
            {
                _errorMensaje = mensaje;
            }
        }
        finally
        {
            _cargando = false;
        }
    }

    private void Cerrar()
    {
        ServicioSesion.CerrarSesion();
    }
}

