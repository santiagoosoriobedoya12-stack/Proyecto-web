@* Hereda de LayoutComponentBase para poder recibir y renderizar la página actual mediante @Body *@
@inherits LayoutComponentBase

<!-- Contenedor principal en columna que ocupa mínimo el 100% del alto de la ventana -->
<div class="app-contenedor">
    <!-- Barra superior de navegación dinámica (cambia según los permisos RBAC de la sesión) -->
    <NavMenu />
    <!-- Zona central de contenido responsivo (Bootstrap .container) -->
    <main class="contenido-principal container">
        <!-- Franja informativa persistente que muestra el usuario conectado y botón de salir -->
        <SesionActual />
        <!-- Marcador donde Blazor inyecta el componente de la ruta activa (Home, Productos, Dashboard, etc.) -->
        @Body
    </main>
</div>
