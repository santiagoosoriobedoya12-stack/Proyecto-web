@* Inyecta el estado de sesión Scoped para leer las rutas autorizadas del usuario actual *@
@inject FrontFacturas.Servicios.EstadoSesion EstadoSesion
@* Implementa IDisposable para desuscribirse del evento al desmontar el menú *@
@implements IDisposable

<!-- Barra de navegación principal corporativa (oculta o muestra módulos dinámicamente según el rol) -->
<nav class="navbar navbar-expand-lg navbar-dark bg-dark mb-4 shadow-sm">
    <div class="container-fluid">
        <!-- Logotipo / Nombre de la plataforma empresarial -->
        <a class="navbar-brand fw-bold" href="/">FactuCorp ERP <span class="badge bg-primary">v4</span></a>
        
        <div class="d-flex flex-wrap gap-2 align-items-center">
            @if (!EstadoSesion.EstaAutenticado)
            {
                <!-- Criterio 8a: Sin identificarse, el menú solo muestra 'Iniciar sesión' -->
                <NavLink class="nav-link text-white fw-bold bg-primary px-3 py-1 rounded" href="sesion">
                    Iniciar sesión
                </NavLink>
            }
            else
            {
                <!-- Enlace a la pantalla inicial -->
                <NavLink class="nav-link text-white" href="" Match="NavLinkMatch.All">
                    Inicio
                </NavLink>

                <!-- Módulos Versión 4 (Analítica, KPIs y Consultas Multitabla) -->
                <NavLink class="nav-link text-info fw-bold" href="dashboard">
                    📊 Dashboard
                </NavLink>
                <NavLink class="nav-link text-info fw-bold" href="consultas">
                    📈 Consultas
                </NavLink>

                @* Cada entrada del menú consulta EstadoSesion.TienePermiso(...) recibido desde GET /api/permisos/mios.
                   NOTA DE SEGURIDAD (Criterio 9 v3): Ocultar aquí es solo UX; la protección real está en el atributo [ExigePermiso] de la API *@

                @if (EstadoSesion.TienePermiso("interfaz.productos"))
                {
                    <NavLink class="nav-link text-white" href="productos">
                        Productos
                    </NavLink>
                }

                @if (EstadoSesion.TienePermiso("interfaz.clientes"))
                {
                    <NavLink class="nav-link text-warning fw-semibold" href="clientes">
                        Clientes
                    </NavLink>
                }

                @if (EstadoSesion.TienePermiso("interfaz.vendedores"))
                {
                    <NavLink class="nav-link text-warning fw-semibold" href="vendedores">
                        Vendedores
                    </NavLink>
                }

                @if (EstadoSesion.TienePermiso("interfaz.facturas"))
                {
                    <NavLink class="nav-link text-warning fw-semibold" href="facturas">
                        Facturas
                    </NavLink>
                    <NavLink class="nav-link text-warning fw-semibold" href="emitir-factura">
                        Emitir Factura
                    </NavLink>
                }

                @if (EstadoSesion.TienePermiso("interfaz.personas"))
                {
                    <NavLink class="nav-link text-white" href="personas">
                        Personas
                    </NavLink>
                }

                @if (EstadoSesion.TienePermiso("interfaz.empresas"))
                {
                    <NavLink class="nav-link text-white" href="empresas">
                        Empresas
                    </NavLink>
                }

                @if (EstadoSesion.TienePermiso("interfaz.roles"))
                {
                    <NavLink class="nav-link text-white" href="roles">
                        Roles
                    </NavLink>
                    <NavLink class="nav-link text-warning fw-semibold" href="roles-por-usuario">
                        Roles por Usuario
                    </NavLink>
                }

                @if (EstadoSesion.TienePermiso("interfaz.usuarios"))
                {
                    <NavLink class="nav-link text-white" href="usuarios">
                        Usuarios
                    </NavLink>
                    <NavLink class="nav-link text-warning fw-semibold" href="usuarios-y-roles">
                        Usuarios y Roles
                    </NavLink>
                }

                @if (EstadoSesion.TienePermiso("interfaz.rutas"))
                {
                    <NavLink class="nav-link text-white" href="rutas">
                        Rutas
                    </NavLink>
                }

                @if (EstadoSesion.TienePermiso("interfaz.permisos"))
                {
                    <NavLink class="nav-link text-warning fw-semibold" href="permisos-por-rol">
                        Permisos por Rol
                    </NavLink>
                }
            }
        </div>
    </div>
</nav>

@code {
    /// <summary>
    /// Se suscribe al evento de cambio de sesión para redibujar el menú dinámico cuando el usuario entra o sale.
    /// </summary>
    protected override void OnInitialized()
    {
        EstadoSesion.AlCambiarEstado += Actualizar;
    }

    /// <summary>
    /// Solicita el re-renderizado seguro del menú en el hilo del circuito Blazor.
    /// </summary>
    private void Actualizar()
    {
        InvokeAsync(StateHasChanged);
    }

    /// <summary>
    /// Libera la suscripción al evento al destruir el componente.
    /// </summary>
    public void Dispose()
    {
        EstadoSesion.AlCambiarEstado -= Actualizar;
    }
}
