# ==============================================================
# VARIABLES DE ENTORNO DE EJEMPLO (NO SUBIR SECRETOS REALES A GIT)
# Copia este archivo como '.env' (ignorado por .gitignore) antes de desplegar.
# ==============================================================

# Base de datos MariaDB
MYSQL_ROOT_PASSWORD=CambiaRootClaveFuerte123!
DB_HOST=mariadb
DB_PORT=3306
DB_NAME=mapa_conocimiento
DB_USER=mapa_user
DB_PASSWORD=CambiaClaveUsuarioBD123!

# Seguridad JWT (mínimo 32 caracteres para HS256)
JWT_SECRET=CambiaEstaClaveSecretaDeMinimo32Caracteres*
JWT_ISSUER=ApiMapaConocimiento
JWT_AUDIENCE=FrontMapaConocimiento
JWT_EXPIRACION_MINUTOS=60

# URL interna de la API FastAPI consumida por el frontend Flask
URL_API=http://api-mapa:8117
