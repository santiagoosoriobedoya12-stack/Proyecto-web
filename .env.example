# ==============================================================
# VARIABLES DE ENTORNO DE EJEMPLO (NO CONTIENE SECRETOS REALES)
# Copia este archivo como '.env' en la raíz (ignorado por Git en .gitignore)
# y asigna tus valores locales o de servidor antes de ejecutar Docker.
# ==============================================================

# Base de datos SQL Server 2022
MSSQL_SA_PASSWORD=CambiaEstaClaveFuerte123!
DB_HOST=sqlserver
DB_PORT=1433
DB_NAME=bdfacturas_sqlserver_local
DB_USER=sa

# Seguridad JWT (mínimo 32 caracteres para HS256)
JWT_KEY=CambiaEstaClaveSecretaDeMinimo32Caracteres*
JWT_ISSUER=ApiFacturas
JWT_AUDIENCE=FrontFacturas
JWT_EXPIRACION_HORAS=1

# Comunicación interna Frontend Flask -> API FastAPI
URL_API=http://api-facturas:8032
