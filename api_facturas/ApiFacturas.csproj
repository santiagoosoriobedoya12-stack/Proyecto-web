<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <!-- Usamos .NET 10 según la especificación del curso -->
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <!-- Excluimos la carpeta de pruebas unitarias para que no se mezcle con la API principal -->
    <DefaultItemExcludes>$(DefaultItemExcludes);pruebas/**</DefaultItemExcludes>
  </PropertyGroup>

  <ItemGroup>
    <!-- Dapper: Micro-ORM para ejecutar SQL escrito a mano y mapear filas a objetos en C# -->
    <PackageReference Include="Dapper" Version="2.1.35" />
    <!-- Microsoft.Data.SqlClient: Proveedor oficial de conexión a SQL Server -->
    <PackageReference Include="Microsoft.Data.SqlClient" Version="5.2.2" />
    <!-- Swashbuckle: Generador de documentación interactiva Swagger UI -->
    <PackageReference Include="Swashbuckle.AspNetCore" Version="7.2.0" />
  </ItemGroup>

  <!-- Aseguramos que los archivos dentro de pruebas no se compilen en este proyecto -->
  <ItemGroup>
    <Compile Remove="pruebas\**" />
    <Content Remove="pruebas\**" />
    <EmbeddedResource Remove="pruebas\**" />
    <None Remove="pruebas\**" />
  </ItemGroup>

</Project>

